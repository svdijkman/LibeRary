$PROBLEM Levetiracetam - Toublanc population PK
$SUBROUTINES ADVAN2 TRANS2
$INPUT ID TIME EVID AMT RATE II SS CMT DV MDV WT FORMULATION_IND
$DATA data.csv IGNORE=@
$THETA
 (0, 2.56, 2560) ; KA
 (0, 2.1, 2100) ; CL/F at 32 kg
 (0, 1.22, 1220) ; formulation factor
 (0, 20.4, 20400) ; V/F at 32 kg
$OMEGA BLOCK(3)
 0.736
 0
 0.0396
 0
 0.00328
 0.0149
$SIGMA
 0.0357
$PK
KA=THETA(1)*exp(ETA(1))
CL=THETA(2)*(THETA(3)^FORMULATION_IND)*(WT/32)^0.75*exp(ETA(2))
V=THETA(4)*(WT/32)*exp(ETA(3))
S2=V
$ERROR
Y=F*(1+ERR(1))
$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER
