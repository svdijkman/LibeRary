$PROBLEM Topiramate - Jovanovic population PK
$SUBROUTINES ADVAN2 TRANS2
$INPUT ID TIME EVID AMT RATE II SS CMT DV MDV WT MDRD CBZ_DAILY_DOSE
$DATA data.csv IGNORE=@
$THETA
 (0, 2, 2000) ; KA
 (0, 1.53, 1530) ; base CL/F
 (0, 0.575, 575) ; V/F per kg
 (0, 0.476, 476) ; carbamazepine-dose effect
 (0, 0.00476, 4.76) ; MDRD effect
$OMEGA
 0.027
$SIGMA
 0.134
$PK
CL=THETA(2)*(1+THETA(4)*CBZ_DAILY_DOSE/1000)*exp(THETA(5)*(MDRD-95.72)+ETA(1))
V=THETA(3)*WT
KA=THETA(1)
S2=V
$ERROR
Y=F*(1+ERR(1))
$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER
