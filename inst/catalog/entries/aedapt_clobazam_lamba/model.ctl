$PROBLEM Clobazam - Lamba population PK
$SUBROUTINES ADVAN2 TRANS2
$INPUT ID TIME EVID AMT RATE II SS CMT DV MDV WT
$DATA data.csv IGNORE=@
$THETA
 (0, 5.99, 5990) ; CL/F at 70 kg
 (0, 96.8, 96800) ; V/F
 (0, 2.5, 2500) ; KA
$OMEGA
 0.221841
 0.4
$SIGMA
 0.04
$PK
CL=THETA(1)*(WT/70)^0.75*exp(ETA(1))
V=THETA(2)*exp(ETA(2))
KA=THETA(3)
S2=V*0.001
$ERROR
Y=F*(1+ERR(1))
$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER
