$PROBLEM Zonisamide - Hashimoto nonlinear population PK
$SUBROUTINES ADVAN13
$INPUT ID TIME EVID AMT RATE II SS CMT DV MDV WT COMED_CBZ
$DATA data.csv IGNORE=@
$MODEL
  COMP=(DEPOT,DEFDOSE)
  COMP=(CENTRAL,DEFOBSERVATION)
$THETA
 (0, 0.741, 741) ; size exponent
 (0, 1.13, 1130) ; carbamazepine VM factor
 (0, 1.27, 1270) ; V per size
 (0, 27.6, 27600) ; VM per size per day
 (0, 45.9, 45900) ; KM
 (0, 2, 2000) FIX ; KA
$OMEGA
 0.0882
$SIGMA
 0.0317
$PK
SIZE=33*(WT/33)^THETA(1)
V=THETA(3)*SIZE
VM=THETA(4)*SIZE*(THETA(2)^COMED_CBZ)
KM=THETA(5)*(1+ETA(1))
KA=THETA(6)
S2=V
$DES
DADT(1)=-KA*A(1)
C=A(2)/V
DADT(2)=KA*A(1)-(VM/24)*C/(KM+C)
$ERROR
Y=F*(1+ERR(1))
$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER
