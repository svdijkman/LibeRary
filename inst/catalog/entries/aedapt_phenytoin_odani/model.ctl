$PROBLEM Phenytoin - Odani nonlinear population PK
$SUBROUTINES ADVAN13
$INPUT ID TIME EVID AMT RATE II SS CMT DV MDV WT COMED_ZNS
$DATA data.csv IGNORE=@
$MODEL
  COMP=(DEPOT,DEFDOSE)
  COMP=(CENTRAL,DEFOBSERVATION)
$THETA
 (0, 9.8, 9800) ; VM per size per day
 (0, 9.19, 9190) ; KM
 (0, 1.23, 1230) ; V per size
 (0, 0.463, 463) ; size exponent
 (0, 1.16, 1160) ; zonisamide factor
 (0, 10, 10000) FIX ; KA
$OMEGA
 0.023
 0.098
 0.206
$SIGMA
 0.033
$PK
SIZE=42*(WT/42)^THETA(4)
VM=THETA(1)*SIZE*exp(ETA(1))
KM=THETA(2)*(THETA(5)^COMED_ZNS)*exp(ETA(2))
V=THETA(3)*SIZE*exp(ETA(3))
KA=THETA(6)
S2=V
$DES
DADT(1)=-KA*A(1)
C=A(2)/V
DADT(2)=KA*A(1)-(VM/24)*C/(KM+C)
$ERROR
Y=F*(1+ERR(1))
$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER
